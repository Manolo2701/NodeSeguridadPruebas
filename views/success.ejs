<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
      background-color: #f8f8f8;
    }
    h1 {
      color: #333;
      text-align: center;
    }
    p {
      text-align: center;
      color: #666;
    }
    nav {
      text-align: center;
      margin-top: 20px;
    }
    nav a {
      color: #4caf50;
      text-decoration: none;
      margin: 0 10px;
    }
    nav a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <h1><%= message %></h1>
  <p>¡Bienvenido, <%= nombre %>! Has iniciado sesión correctamente.</p>
  <nav>
    <a href="/dashboard">Ir al Dashboard</a> |
    <a href="/">Ir al Inicio</a>
  </nav>
</body>
</html>
