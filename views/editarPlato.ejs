<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Editar Plato</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
        background-color: #f8f8f8;
      }
      h2 {
        color: #333;
        text-align: center;
      }
      form {
        max-width: 600px;
        margin: 0 auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      label {
        display: block;
        margin-top: 10px;
        color: #666;
      }
      input, textarea {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
      }
      button {
        display: block;
        width: 100%;
        margin-top: 20px;
        padding: 10px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      button:hover {
        background-color: #45a049;
      }
    </style>
  </head>
  <body>
    <h2>Editar Plato</h2>
    <form action="/api/platos/<%= plato.id %>" method="POST">
      <input type="hidden" name="_method" value="PUT">
      <label for="nombre">Nombre:</label>
      <input type="text" name="nombre" value="<%= plato.nombre %>" required />
      <label for="precio">Precio:</label>
      <input type="number" step="0.01" name="precio" value="<%= plato.precio %>" required />
      <label for="descripcion">Descripción:</label>
      <textarea name="descripcion"><%= plato.descripcion %></textarea>
      <label for="categoria">Categoría:</label>
      <input type="text" name="categoria" value="<%= plato.categoria %>" required />
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Actualizar Plato</button>
    </form>
  </body>
</html>
